2F6DB5;strokeWidth=1.6;fontFamily=Helvetica;fontSize=11;fontColor=#1B2438;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;opacity=100;" vertex="1" parent="1"><mxGeometry x="1040.0" y="1161.0" width="26.0" height="22.0" as="geometry"/></mxCell><mxCell id="r163" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#2F6DB5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1047.0" y="1166.0" width="12" height="12" as="geometry"/></mxCell><mxCell id="r164" value="Incremento: lo terminado (DoD) que se demuestra en la Sprint Review" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1B2438;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1074.0" y="1166.0" width="520.0" height="16.0" as="geometry"/></mxCell><mxCell id="r165" value="Número en la barra = puntos de la épica en el sprint" style="text;html=1;fontFamily=Helvetica;fontSize=10.5;fontColor=#444;fontStyle=0;align=right;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1560.0" y="1166.0" width="300.0" height="16.0" as="geometry"/></mxCell><mxCell id="r166" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F7F7F9;strokeColor=#9AA3B2;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fontColor=#1B2438;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;opacity=100;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="300.0" y="1204.0" width="1560.0" height="54.0" as="geometry"/></mxCell><mxCell id="r167" value="&lt;b&gt;Mejoras futuras declaradas (no iniciadas, fuera del alcance de este proyecto)&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#555;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="320.0" y="1212.0" width="1500.0" height="20.0" as="geometry"/></mxCell><mxCell id="r168" value="MF-01 Facturación electrónica (SII) - MF-02 Control sanitario de recetas (ISP) - MF-03 Precios dinámicos" style="text;html=1;fontFamily=Helvetica;fontSize=10.5;fontColor=#555;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="320.0" y="1234.0" width="1500.0" height="18.0" as="geometry"/></mxCell><mxCell id="r169" value="&lt;i&gt;Sprint 2 cierra el jueves 17-09 por el feriado del 18-09. Sprint 4 cierra el jueves 15-10 con la entrega del 80% y el Sprint 5 parte el viernes 16-10; desde el Sprint 6 se vuelve a lunes a viernes.&lt;br&gt;Avance al 21-10-2026. Las fechas desde el Incremento 5 son objetivos del plan: se revisan en cada Sprint Review sin cambiar el alcance.&lt;/i&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=10.5;fontColor=#666;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="320.0" y="1266.0" width="1500.0" height="34.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>