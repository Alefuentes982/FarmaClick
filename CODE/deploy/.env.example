# Copiar como .env en la VM (chmod 600 .env). Nunca subir a Git: aquí viven los secretos del entorno.
GHCR_OWNER=<usuario-o-organizacion-de-github-en-minusculas>
IMAGE_TAG=prod            # prod en la VM de producción, dev en la de dev/staging

# Base de datos (Supabase, Transaction pooler, rol app_backend) y autenticación
DATABASE_URL=postgresql://app_backend.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API
PORT=3000
NODE_ENV=production
TRUST_PROXY=2             # prod: balanceador + Nginx. En dev (sin balanceador) usar 1
CORS_ORIGIN=https://<dominio-prod>   # en dev: http://<ip-de-la-vm-dev>
EMPRESA_NOMBRE=
EMPRESA_RUT=
EMPRESA_DIRECCION=
DEVOLUCION_MAX_DIAS=30

# Envío de comprobantes por correo (opcional). Sin SMTP_HOST el botón "Enviar comprobante" avisa que no está configurado.
# Gmail: usar una "contraseña de aplicación" (requiere verificación en 2 pasos). Oracle Cloud bloquea el puerto 25: usar 587 o 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cierre automático de cajas a las 23:59 (salvo farmacias de turno) y recordatorios por correo 60 y 30 minutos antes.
# Sin SMTP_HOST solo se hace el cierre. Para desactivar las tareas en esta instancia: TAREAS_CAJA=off
# TAREAS_CAJA=on
