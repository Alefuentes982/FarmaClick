# Cadena del pooler de Supabase (modo transacción) con el rol app_backend.
# Antes: ALTER ROLE app_backend LOGIN PASSWORD '<secreto>';
# Usuario del pooler: app_backend.<project-ref>
DATABASE_URL=postgresql://app_backend.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# Supabase Auth (Project Settings > API). La service role key es secreta: solo vive en el backend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
CORS_ORIGIN=http://localhost:5173
# Saltos de proxy delante de la API (rate limit por IP real). 1 = un proxy; 2 = balanceador de Oracle + Nginx.
TRUST_PROXY=1
# En producción (contenedor) debe ser production: con esto el login de desarrollo (AUTH_MODE=local) no arranca.
NODE_ENV=production
# Datos de la empresa en los PDF (órdenes de compra y comprobantes) y plazo de devoluciones en días.
EMPRESA_NOMBRE=
EMPRESA_RUT=
EMPRESA_DIRECCION=
DEVOLUCION_MAX_DIAS=30

# Envío de comprobantes por correo (opcional). Sin SMTP_HOST, el botón avisa que no está configurado.
# Ejemplo con Gmail: crear una "contraseña de aplicación" en la cuenta (requiere verificación en 2 pasos).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE: true solo con el puerto 465 (por defecto se deduce del puerto).
# SMTP_SECURE=false
# SMTP_USER=farmacia@gmail.com
# SMTP_PASS=<contraseña de aplicación>
# SMTP_FROM=FarmaClick <farmacia@gmail.com>

# Cierre automático de cajas a las 23:59 (salvo farmacias de turno) y recordatorios por correo 60 y 30 minutos antes.
# Sin SMTP_HOST solo se hace el cierre. Para desactivar las tareas en esta instancia: TAREAS_CAJA=off
# TAREAS_CAJA=on
